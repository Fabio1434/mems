# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Résultats de benchmark générés localement (volumineux, régénérables)
scripts/benchmark_results/

# Fichiers de configuration spécifiques à un déploiement (garder uniquement
# le modèle versionné, config/example.yaml)
config/*.yaml
!config/example.yaml

# Modèles entraînés sauvegardés (spécifiques à un déploiement, volumineux)
models/
*.joblib

# Logs
*.log

# Objets BPF compilés localement (si compilation manuelle avec clang)
*.o

# Environnements virtuels
.venv/
venv/

# Fichiers d'éditeur / OS
.vscode/
.idea/
.DS_Store
